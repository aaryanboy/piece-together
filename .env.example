# ─── Frontend (Vercel) ───
# Public canonical URL for SEO, sitemap, and social sharing (set before building for production)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Set this to your deployed Socket.io backend URL
NEXT_PUBLIC_SOCKET_URL=https://your-socket-server.onrender.com

# ─── Backend (Render / Railway) ───
# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=https://your-app.vercel.app

# Port for the Socket.io server (Render/Railway inject PORT automatically)
PORT=4000

# Optional: SQLite database directory (use persistent disk mount path)
# DB_DIR=/data
# DB_PATH=/data/piece_together.db
